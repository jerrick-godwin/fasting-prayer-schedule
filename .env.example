# Server-only values. Never prefix these with NEXT_PUBLIC_.
# Use false for UI-only local preview; use true on Vercel.
CALENDLY_ENABLED=true
CALENDLY_TOKEN=replace_with_your_personal_access_token

# Copy the canonical API URI for each secret Calendly event type.
CALENDLY_EVENT_TYPE_120=https://api.calendly.com/event_types/replace_with_120_minute_uuid
CALENDLY_EVENT_TYPE_180=https://api.calendly.com/event_types/replace_with_180_minute_uuid
CALENDLY_EVENT_TYPE_235=https://api.calendly.com/event_types/replace_with_235_minute_uuid

# Must exactly match the required phone question configured in Calendly.
CALENDLY_PHONE_QUESTION=Phone number
